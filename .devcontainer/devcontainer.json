{
  "name": "fCCContribute",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:26",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Website",
      "onAutoForward": "openBrowser"
    }
  },
  "containerEnv": {
    "ASTRO_TELEMETRY_DISABLED": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "oxc.oxc-vscode",
        "astro-build.astro-vscode",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "bash -ic 'nvm install && nvm use && nvm alias default $(nvm current) && npm install --global pnpm@12.17.0 && pnpm install --frozen-lockfile'",
  "postAttachCommand": {
    "Develop": "bash -ic 'nvm use && pnpm develop'"
  }
}
