{
  "name": "@freecodecamp/contribute",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "is-ci || husky",
    "develop": "astro dev",
    "prebuild": "node scripts/unshallow.mjs",
    "build": "astro build",
    "preview": "pnpm build && wrangler dev",
    "format": "prettier . --write && eslint . --fix",
    "lint": "prettier . --check && eslint .",
    "test": "vitest run",
    "test:usability": "pnpm build && playwright test",
    "clean": "pnpm dlx rimraf .astro dist",
    "check:astro": "astro check"
  },
  "lint-staged": {
    "**/*.{astro,mjs,cjs,js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.{yaml,yml,md,mdx}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/nimbus-docs": "0.19.2",
    "@iconify-json/ph": "1.2.2",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.5",
    "clsx": "2.1.1",
    "satori": "0.26.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "lint-staged": "17.6.0",
    "pagefind": "1.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "wrangler": "4.156.2"
  },
  "packageManager": "pnpm@12.17.0"
}
