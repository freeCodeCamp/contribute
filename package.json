{
  "name": "@freecodecamp/contribute",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "is-ci || husky",
    "develop": "astro dev",
    "prebuild": "node scripts/unshallow.mjs",
    "build": "astro build && cf-wrangler build",
    "preview": "pnpm build && pnpm preview:built",
    "format": "astro sync && oxlint --fix --deny-warnings . && eslint . --fix && oxfmt --write .",
    "lint": "astro sync && oxfmt --check . && oxlint --deny-warnings . && eslint .",
    "test": "vitest run",
    "test:usability": "pnpm build && playwright test",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const path of ['.astro', '.nimbus', 'dist', '.cloudflare/output']) rmSync(path, { recursive: true, force: true });\"",
    "check:astro": "astro check",
    "preview:built": "cf-wrangler dev --local"
  },
  "lint-staged": {
    "**/*.astro": [
      "oxlint --fix --deny-warnings",
      "eslint --fix",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "**/*.{mjs,cjs,js,jsx,ts,tsx,mts,cts}": [
      "oxlint --fix --deny-warnings",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "**/*.{json,jsonc,yaml,yml,md,mdx,css,html,svg}": [
      "oxfmt --write --no-error-on-unmatched-pattern"
    ]
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/nimbus-docs": "0.19.2",
    "@iconify-json/ph": "1.2.2",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.7",
    "clsx": "2.1.1",
    "satori": "0.26.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.2",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "8.72.1",
    "cf": "1.0.0-beta.28",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "pagefind": "1.6.0",
    "sharp": "0.35.5",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^26.13.0",
    "pnpm": "^12.17.0"
  }
}
