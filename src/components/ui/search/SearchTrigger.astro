---
/** Button that opens the search dialog. Cmd+K on macOS, Ctrl+K elsewhere. */
import { Icon } from '@/components/ui/icon';
---

<button
  data-slot='search-trigger'
  data-search-trigger
  type='button'
  class='flex items-center gap-2 rounded-md border border-border bg-card text-sm leading-5 text-muted-foreground transition-colors hover:border-border-strong hover:text-foreground p-2 sm:px-2.5 sm:py-1.5'
  aria-keyshortcuts='Control+K'
>
  <Icon name='ph:magnifying-glass' class='h-4 w-4' />
  <span class='sr-only md:not-sr-only'>Search</span><span class='sr-only'>
    documentation</span
  >
  <kbd
    aria-hidden='true'
    dir='ltr'
    class='hidden sm:inline-flex items-center gap-0.5 rounded-sm border border-border bg-muted px-1.5 font-mono text-xs text-muted-foreground'
  >
    <span data-shortcut-key>Ctrl</span>K
  </kbd>
</button>

<script>
  import './search-trigger.client';
</script>
