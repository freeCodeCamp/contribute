{
  "extends": [
    "github>freecodecamp/renovate-config",
    "github>freecodecamp/renovate-config:automerge"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["@astrojs/check"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Docker updates wait for a person: no required check builds them.",
      "matchManagers": ["dockerfile", "docker-compose", "devcontainer"],
      "automerge": false
    }
  ]
}
