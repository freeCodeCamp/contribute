{
  "extends": [
    "github>freecodecamp/renovate-config",
    "github>freecodecamp/renovate-config:automerge"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["@astrojs/check"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Docker updates wait for a person: no required check builds them.",
      "matchManagers": ["dockerfile", "docker-compose", "devcontainer"],
      "automerge": false
    },
    {
      "description": "Vite+ pins its Vite core alias and Vitest. Update them in one PR and run `vp migrate` on its branch before merging.",
      "groupName": "Vite+",
      "matchPackageNames": [
        "vite-plus",
        "@voidzero-dev/vite-plus-core",
        "vitest"
      ],
      "automerge": false
    }
  ]
}
